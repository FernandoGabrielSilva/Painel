{
  "name": "Painel",
  "version": "1.0.8",
  "description": "Painel Electron totalmente standalone para Linux",
  "main": "main.js",
  "license": "MIT",
  "author": {
    "name": "Fernando Gabriel Silva",
    "email": "fernandogabrielsadasilva@gmail.com"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux"
  },
  "build": {
    "appId": "com.nandex.painel",
    "productName": "Painel",
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "category": "Utility",
      "icon": "assets/app.png",
      "artifactName": "${productName}-${arch}.${ext}",
      "maintainer": "Fernando Gabriel Silva <fernandogabrielsadasilva@gmail.com>"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {}
}

